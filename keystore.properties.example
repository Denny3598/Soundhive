# Copy this file to keystore.properties and fill in your private signing values.
# The real keystore and passwords must never be committed.

# Example:
# keytool -genkeypair -v -keystore soundhive-release.jks 
#   -keyalg RSA -keysize 2048 -validity 10000 -alias soundhive

storeFile=soundhive-release.jks
storePassword=
keyAlias=soundhive
keyPassword=
